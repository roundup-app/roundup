          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 200
            },
            "kind": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 200
            },
            "since": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 200
            },
            "chip": {
              "type": [
                "string",
                "null"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "kind": {
              "type": "string",
              "const": "row"
            }
          },
          "required": [
            "kind",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 200
            },
            "tone": {
              "$ref": "#/$defs/Tone"
            },
            "kind": {
              "type": "string",
              "const": "chip"
            }
          },
          "required": [
            "kind",
            "text",
            "tone"
          ]
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 200
            },
            "action": {
              "$ref": "#/$defs/PanelAction"
            },
            "kind": {
              "type": "string",
              "const": "button"
            }
          },
          "required": [
            "kind",
            "label",
            "action"
          ]
        },
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 200
            },
            "name": {
              "type": "string",
              "maxLength": 200
            },
            "kind": {
              "type": "string",
              "const": "input"
            }
          },
          "required": [
            "kind",
            "label",
            "name"
          ]
        }
      ]
    },
    "Tone": {
      "type": "string",
      "enum": [
        "neutral",
        "waiting",
        "fault"
      ]
    },
    "PanelAction": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "args": {
          "default": null
        }
      },
      "required": [
        "name"
      ]
    }
