{
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": true,
          "default": []
        },
        "t": {
          "type": "string",
          "const": "registered"
        }
      },
      "required": [
        "t"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "params": {
          "default": null
        },
        "t": {
          "type": "string",
          "const": "call"
        }
      },
      "required": [
        "t",
        "id",
        "path"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "answer": {
          "default": null
        },
        "failure": {
          "type": [
            "string",
            "null"
          ]
        },
        "t": {
          "type": "string",
          "const": "result"
        }
      },
      "required": [
        "t",
        "id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "cause": {
          "type": "string",
          "default": ""
        },
        "t": {
          "type": "string",
          "const": "failed"
        }
      },
      "required": [
        "t"
      ]
    },
    {
      "type": "object",
      "properties": {
        "ask": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "panel": {
          "$ref": "#/$defs/Panel"
        },
        "t": {
          "type": "string",
          "const": "show"
        }
      },
      "required": [
        "t",
        "ask",
        "panel"
      ]
    },
    {
      "type": "object",
      "properties": {
        "note": {
          "type": "string",
          "maxLength": 80
        },
        "t": {
          "type": "string",
          "const": "health"
        }
      },
      "required": [
        "t",
        "note"
      ]
    }
  ],
  "$defs": {
    "Panel": {
      "type": "object",
