+// Temporary R23 diagnostic only. Instant debug values are Linux CLOCK_MONOTONIC.
+pub fn r23_mark(stage: &str, detail: std::fmt::Arguments<'_>) {
+    let _ = (stage, detail); // Diagnostic hooks remain; synchronous marker output is disabled.
+}
+
+async fn r23_poll<T>(label: String, future: impl std::future::Future<Output = T>) -> T {
+    let mut future = std::pin::pin!(future);
+    std::future::poll_fn(|cx| {
+        r23_mark("poll_enter", format_args!("label={label}"));
+        let waker = std::task::Waker::from(std::sync::Arc::new(R23Wake {
+            original: cx.waker().clone(), label: label.clone(), target: format!("{:?}", tokio::task::try_id()),
+        }));
+        let mut observed = std::task::Context::from_waker(&waker);
+        let result = future.as_mut().poll(&mut observed);
+        r23_mark("poll_exit", format_args!("label={label} pending={}", result.is_pending()));
+        result
+    }).await
+}
+
+struct R23Wake {
+    original: std::task::Waker,
+    label: String,
+    target: String,
+}
+impl std::task::Wake for R23Wake {
+    fn wake(self: std::sync::Arc<Self>) { self.wake_by_ref(); }
+    fn wake_by_ref(self: &std::sync::Arc<Self>) {
+        r23_mark("task_wake", format_args!("target={} label={}", self.target, self.label));
+        self.original.wake_by_ref();
+    }
+}
