{
  "productName": "roundup",
  "identifier": "dev.roundup.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../apps/desktop/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [{ "title": "roundup", "width": 1280, "minWidth": 1280, "visible": false, "titleBarStyle": "Overlay", "hiddenTitle": true, "transparent": true }],
    "security": {
      "assetProtocol": { "enable": true, "scope": ["**/*.png", "**/*.jpg", "**/*.jpeg", "**/*.gif", "**/*.webp", "**/*.heic", "**/*.PNG", "**/*.JPG", "**/*.JPEG", "**/*.GIF", "**/*.WEBP", "**/*.HEIC"] }
    }
  }
}
