import { openPage, chromePath } from '/tmp/roundup-motion/apps/desktop/src/testing/chromePage.ts';
import { writeFileSync, mkdirSync } from 'node:fs';
const out='/tmp/roundup-motion/artifacts/ux/U3010g';
mkdirSync(out,{recursive:true});
const page=await openPage(chromePath()!,{root:'/tmp/roundup-motion/apps/desktop'});
try {
 await page.scheme('dark');
 await page.load('/harness.html?seed=empty-project');
 await page.until('() => Boolean(window.__fake && document.querySelector(".window"))');
 const result=await page.call(`async () => {
  const app=window.__fake.app;
  const spawn=app.handlers['agent.spawn'];
  app.handlers['agent.spawn']=async params=>{const row=await spawn(params); return app.rpc('rail.rename',{id:row.id,name:params.name});};
  app.handlers['agent.signal']=({id,payload})=>{window.__fake.setStatus(id,payload.hook_event_name==='UserPromptSubmit'?'working':'idle','fixture'); return null;};
  await app.rpc('rail.createWorkstream',{name:'payments',parent:null});
  const {prepareFixture}=await import('/src/perf/fixture.ts');
  const home=(await app.rpc('rail.tree',null))[0].id; await app.rpc('terminal.open',{workstream:home});
  const terminals=await app.rpc('terminal.list',null);
  const fixture=await prepareFixture(app,'/temporary',terminals[0]?.id ?? 'missing');
  window.__motionFixture=fixture;
  document.body.dispatchEvent(new KeyboardEvent('keydown',{key:'k',code:'KeyK',metaKey:true,bubbles:true,cancelable:true}));
  document.body.dispatchEvent(new KeyboardEvent('keydown',{key:'s',code:'KeyS',bubbles:true,cancelable:true}));
  const {domTodos}=await import('/src/perf/frame_run.ts');
  window.__motionJournal=[];
  window.__motionTodos=domTodos(app,fixture,window.__motionJournal);
  await window.__motionTodos.create();
  const ids=await window.__motionTodos.open();
  await window.__motionTodos.complete(ids.at(-1));
  return {fixture,checks:await window.__checks()};
 }`);
 await page.until('() => Boolean(document.querySelector(".shelf-done-line button"))');
 const fold = await page.call('async () => ({completed:await window.__motionTodos.toggleFold(), journal:window.__motionJournal, checks:await window.__checks()})');
 writeFileSync(out+'/todo-actions.json',JSON.stringify(fold,null,2));
 writeFileSync(out+'/fixture-preparation.json',JSON.stringify(result,null,2));
 writeFileSync(out+'/fixture.png',Buffer.from(await page.shot(),'base64'));
 const points=await page.call(`() => [4,1].map(id=>{ const row=document.querySelector('.shelf [data-todo="'+id+'"] .shelf-title'); const b=row.getBoundingClientRect(); return {x:b.x+b.width/2,y:b.y+b.height/2,top:b.top}; })`);
 await page.hover(points[0].x,points[0].y);
 await page.call('() => {window.__motionReorder=window.__motionTodos.reorder(4,1); return true;}');
 await page.down(points[0].x,points[0].y);
 await page.pointer('move',points[0].x,points[0].y-6);
 await page.until('() => Boolean(document.querySelector("[data-dnd-placeholder]"))',1000);
 for(let step=1;step<=5;step++) {await page.pointer('move',points[0].x,points[0].y+(points[1].top-points[0].y)*step/5);await page.call('() => new Promise(requestAnimationFrame)');}
 await page.release(points[0].x,points[1].top);
 const reorder=await page.call('async () => ({completed:await window.__motionReorder,journal:window.__motionJournal,rows:await window.__fake.app.rpc("todo.list",null),checks:await window.__checks()})');
 writeFileSync(out+'/pointer-reorder.json',JSON.stringify(reorder,null,2));
 writeFileSync(out+'/pointer-reorder.png',Buffer.from(await page.shot(),'base64'));
 await page.call('async () => {await window.__motionTodos.create(); const ids=await window.__motionTodos.open(); await window.__motionTodos.complete(ids.at(-1)); return true;}');
 await page.until('() => Boolean(document.querySelector(".shelf-done-line button"))');
 await page.call('async () => window.__motionTodos.toggleFold()');
 const second=await page.call(`() => [8,5].map(id=>{const b=document.querySelector('.shelf [data-todo="'+id+'"] .shelf-title').getBoundingClientRect();return {x:b.x+b.width/2,y:b.y+b.height/2,top:b.top};})`);
 await page.hover(second[0].x,second[0].y);
 await page.call('() => {window.__motionReorder=window.__motionTodos.reorder(8,5);return true;}');
 await page.down(second[0].x,second[0].y);
 await page.pointer('move',second[0].x,second[0].y-6);
 await page.until('() => Boolean(document.querySelector("[data-dnd-placeholder]"))',1000);
 for(let step=1;step<=5;step++){await page.pointer('move',second[0].x,second[0].y+(second[1].top-second[0].y)*step/5);await page.call('() => new Promise(requestAnimationFrame)');}
 await page.release(second[0].x,second[1].top);
 const repeated=await page.call('async () => ({completed:await window.__motionReorder,journal:window.__motionJournal,rows:await window.__fake.app.rpc("todo.list",null),checks:await window.__checks()})');
 writeFileSync(out+'/repeated-pointer-reorder.json',JSON.stringify(repeated,null,2));
 writeFileSync(out+'/repeated-pointer-reorder.png',Buffer.from(await page.shot(),'base64'));

} catch(error) {
 writeFileSync(out+'/observer-failure.json',JSON.stringify({stage:'Chromium preparation only',error:String(error)},null,2));
 writeFileSync(out+'/incomplete.png',Buffer.from(await page.shot(),'base64'));
 console.error(String(error)); process.exitCode=2;
} finally {await page.close();}
