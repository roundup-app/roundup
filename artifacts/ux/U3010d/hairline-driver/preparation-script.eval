const {execFileSync}=require('node:child_process');
const fs=require('node:fs');
const path='/tmp/roundup-motion/apps/desktop/node_modules/.bin/agent-browser';
const b=(...args)=>execFileSync(path,['--session','motion-40445298668',...args],{encoding:'utf8',timeout:60000});
const e=s=>JSON.parse(b('eval',s));
const mode=process.argv[2]??'reserved';
const dir='/tmp/roundup-motion/artifacts/ux/U3010d/hairline-driver';fs.mkdirSync(dir,{recursive:true});
b('set','viewport','1512','950'); b('set','media','dark');
b('open','http://127.0.0.1:5199/harness.html?view=workstreams&items=1&tabs=1&seed=tree-40');b('wait','.shelf-tabs');
e(`localStorage.clear();localStorage.setItem('roundup:widths:/Users/you/harness',JSON.stringify({rail:288,shelf:320}));true`);
b('reload');b('wait','.shelf-tabs');
if(mode==='overlay'){e(`document.documentElement.style.setProperty('--centre-min-width','1008px');true`);b('set','viewport','1512','949');b('set','viewport','1512','950');}
b('click','.rail [data-id="tokens"] .row-state');b('wait','.xterm-screen');
b('click','.todos-tab [data-shelf-group="unassigned"] [data-part="branch-control"]');b('click','.shelf [data-todo="1"] .todo-row-button');
b('click','.shelf [data-todo="1"] .row-controls button[aria-label="Open"]');
e(`(async()=>{await new Promise(r=>requestAnimationFrame(r));await Promise.all(document.getAnimations().filter(a=>a.effect?.target?.matches?.('.drawer,.shelf,.columns')).map(a=>a.finished.catch(()=>{})));return true})()`);
b('click','.drawer .close');
e(`(async()=>{await new Promise(r=>requestAnimationFrame(r));await Promise.all(document.getAnimations().filter(a=>a.effect?.target?.matches?.('.drawer,.shelf,.columns')).map(a=>a.finished.catch(()=>{})));return true})()`);
b('wait','--load','networkidle');b('stream','disable');const stream=b('stream','enable').match(/ws:\/\/[^\s]+/)[0];
try {
const result=e(`(async()=>{
const {domLayers,layersCycle}=await import('/src/perf/frame_run.ts');
const journal=[];const layers=domLayers(journal);const input=new WebSocket(${JSON.stringify(stream)});
await new Promise((resolve,reject)=>{input.onerror=reject;input.onmessage=event=>{if(JSON.parse(event.data).type==='frame'){input.onmessage=null;resolve();}}});
const frame=()=>new Promise(r=>requestAnimationFrame(r));
const activate=async selector=>{
 const target=document.querySelector(selector);const edge=selector==='.drawer';const box=(edge?target:target.querySelector('svg')??target).getBoundingClientRect();
 const x=box.left+(edge?parseFloat(getComputedStyle(target).borderLeftWidth)/2:box.width/2),y=box.top+box.height/2;
 const event=new Promise(resolve=>{const listener=e=>{if(!target.contains(e.target))return;window.removeEventListener(edge?'pointerdown':'click',listener);resolve(e.isTrusted);};window.addEventListener(edge?'pointerdown':'click',listener);});
 for(const eventType of ['mousePressed','mouseReleased']) input.send(JSON.stringify({type:'input_mouse',eventType,x,y,button:'left',clickCount:1}));
 return event;
};
try{
 let done=false;const sequence=layersCycle(layers)(0).then(result=>{done=true;return result;});
 await Promise.race([sequence,activate('.shelf [data-todo="1"] .row-controls button[aria-label="Open"]')]);
 for(let segment=0;segment<3;segment++){
  while(!journal[segment]?.completed && !done){if(journal[segment]?.observed!==null&&journal[segment]?.completed===false&&Math.abs(journal[segment]?.observed-journal[segment]?.destination)<1)break;await frame();}
  if(!journal[segment]?.completed) throw new Error('half crossing incomplete: '+segment);
  if(segment<2) await Promise.race([sequence,activate(segment===0?'.drawer':'.shelf [data-todo="1"] .row-controls button[aria-label="Open"]')]);
  else for(const eventType of ['keyDown','keyUp']) input.send(JSON.stringify({type:'input_keyboard',eventType,key:'Escape',code:'Escape',text:'',windowsVirtualKeyCode:27}));
 }
 return {completed:await sequence,journal,mode:document.querySelector('.window').dataset.shelfMode,checks:window.__checks(),engine:'chromium',qualification:'preparation only; not native timing'};
}catch(error){return {completed:false,error:String(error),journal,mode:document.querySelector('.window').dataset.shelfMode,checks:window.__checks(),engine:'chromium',qualification:'preparation only; not native timing'};}finally{input.close();}
})()`);
fs.writeFileSync(dir+'/'+mode+'.json',JSON.stringify(result,null,2));console.log(JSON.stringify(result));b('screenshot',dir+'/'+mode+'.png');
}catch(error){fs.writeFileSync(dir+'/'+mode+'-failure.txt',String(error));throw error;}
