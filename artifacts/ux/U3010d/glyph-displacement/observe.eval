const {execFileSync} = require('node:child_process');
const fs = require('node:fs');
const browser = (...args) => execFileSync('agent-browser', ['--session', 'motion-40469285119', ...args], {encoding: 'utf8', timeout: 60000});
const dir = '/tmp/motion-native-workloads/artifacts/ux/U3010d/glyph-displacement';
browser('set', 'viewport', '1512', '950');
browser('set', 'media', 'dark');
browser('open', 'http://127.0.0.1:5198/harness.html?view=workstreams&items=1&tabs=1&seed=empty-project');
browser('eval', `(async()=>{
 const c=window.__fake,a=c.app;
 const h=await a.rpc('rail.createWorkstream',{name:'measurement',parent:null});
 const t=await a.rpc('terminal.open',{workstream:h.id});
 const spawn=a.handlers['agent.spawn'];
 a.handlers['agent.spawn']=async p=>{const r=await spawn(p);await a.rpc('rail.rename',{id:r.id,name:p.name});return {...r,name:p.name};};
 a.handlers['agent.signal']=p=>{c.setStatus(p.id,p.payload.hook_event_name==='UserPromptSubmit'?'working':'idle','fixture');return null;};
 const {prepareFixture}=await import('/src/perf/fixture.ts');
 window.motionFixture=await prepareFixture(a,'/Users/you/harness',t.terminal_id);
 for(const control of document.querySelectorAll('.rail [aria-expanded=false] .rail-chevron'))control.click();
 await new Promise(r=>requestAnimationFrame(r));
 return true;
})()`);
browser('click', '.rail-row[data-id="n1"] .row-state');
const read = `(async()=>{
 const {glyphDisplacement}=await import('/src/perf/frame_run.ts');
 return {engine:'chromium',qualification:'geometry reader only; no halfway source switch, native stream or WKWebView timing',fixture:window.motionFixture,reduced:matchMedia('(prefers-reduced-motion: reduce)').matches,viewport:{width:innerWidth,height:innerHeight,device_pixel_ratio:devicePixelRatio},observed:glyphDisplacement(window.motionFixture),checks:window.__checks()};
})()`;
fs.writeFileSync(dir+'/moving.json', browser('eval',read));
browser('screenshot', dir+'/moving.png');
browser('set','media','dark','reduced-motion');
fs.writeFileSync(dir+'/reduced.json', browser('eval',read));
browser('screenshot', dir+'/reduced.png');
