const {execFileSync} = require('node:child_process');
const fs = require('node:fs');
const browser = (...args) => execFileSync('agent-browser', ['--session', 'motion-40474229830', ...args], {encoding:'utf8', timeout:60000});
const dir = process.cwd() + '/artifacts/ux/U3010d/todo-displacement';
browser('open','http://localhost:5197/harness.html?view=workstreams&items=1&tabs=1&seed=empty-project');
browser('wait','--fn','Boolean(window.__fake)');
console.log(browser('eval', `(async()=>{
 const c=window.__fake,a=c.app;
 const h=await a.rpc('rail.createWorkstream',{name:'measurement',parent:null});
 const t=await a.rpc('terminal.open',{workstream:h.id});
 const spawn=a.handlers['agent.spawn'];
 a.handlers['agent.spawn']=async p=>{const r=await spawn(p);await a.rpc('rail.rename',{id:r.id,name:p.name});return {...r,name:p.name};};
 a.handlers['agent.signal']=p=>{c.setStatus(p.id,p.payload.hook_event_name==='UserPromptSubmit'?'working':'idle','fixture');return null;};
 const {prepareFixture}=await import('/src/perf/fixture.ts');
 window.motionFixture=await prepareFixture(a,'/Users/you/harness',t.terminal_id);
 for(const control of document.querySelectorAll('.rail [aria-expanded=false] .rail-chevron'))control.click();
 return window.motionFixture.sha256;
})()`));
browser('click', '.rail-row[data-id="n1"] .row-state');
console.log(browser('eval', `(async()=>{
 const {expandFixtureTodos}=await import('/src/perf/frame_run.ts');
 if(document.querySelector('[data-layout-root]').dataset.shelf!=='open'){
 document.body.dispatchEvent(new KeyboardEvent('keydown',{key:'k',code:'KeyK',metaKey:true,bubbles:true,cancelable:true}));
 await new Promise(resolve=>requestAnimationFrame(resolve));
 document.body.dispatchEvent(new KeyboardEvent('keydown',{key:'s',code:'KeyS',bubbles:true,cancelable:true}));
 }
 await expandFixtureTodos(window.motionFixture);
 return window.__checks();
})()`));
const observation = browser('eval', `(async()=>{
 const {todoDisplacement}=await import('/src/perf/frame_run.ts');
 const a=window.__fake.app;
 const action={action:'reorder',targets:[4,1],source:'rpc',at_ms:performance.now(),completed_at_ms:null,completed:false};
 window.motionAction=action;
 await a.rpc('todo.reorder',{id:4,before:1});
 action.completed_at_ms=performance.now(); action.completed=true;
 const deadline=performance.now()+400, samples=[];
 while(performance.now()<deadline){
  await new Promise(r=>requestAnimationFrame(r));
  const geometry=todoDisplacement(window.motionFixture,action);
  samples.push({at_ms:performance.now(),geometry});
  if(geometry.rows.some(row=>row.progress>=0.5)) return {engine:'chromium',qualification:'RPC preparation and geometry reader only; no trusted gesture or halfway preference switch; no native stream or WKWebView timing',fixture:window.motionFixture,action,samples,checks:window.__checks()};
 }
 return {error:'no moving row crossed halfway within 400ms',samples,checks:window.__checks()};
})()`);
fs.writeFileSync(dir+'/moving.json',observation);
console.log(observation);
browser('screenshot',dir+'/moving.png');
browser('set','media','dark','reduced-motion');
fs.writeFileSync(dir+'/reduced.json',browser('eval',`(async()=>{const {todoDisplacement}=await import('/src/perf/frame_run.ts');return {engine:'chromium',geometry:todoDisplacement(window.motionFixture,window.motionAction),checks:window.__checks(),qualification:'settled reader only; no halfway preference switch'};})()`));
browser('screenshot',dir+'/reduced.png');
