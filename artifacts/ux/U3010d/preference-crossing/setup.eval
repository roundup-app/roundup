(async()=>{
const frame=document.createElement('iframe');
frame.id='motion-observer';frame.style='position:fixed;inset:0;width:1512px;height:950px;border:0;z-index:99999';
frame.srcdoc=`<!doctype html><html><head></head><body style="margin:0"><div id="root"></div><script type="module">
import '/src/tokens.css';
import '/src/styles.css';
import '/src/scrollbar.css';
import {createRoot} from '/node_modules/.vite/deps/solid-js.js';
import {render} from '/node_modules/.vite/deps/solid-js_web.js';
import {App} from '/src/App.tsx';
import {seedApp} from '/src/testing/seeds.ts';
import {createReducedMotion} from '/src/app/reducedMotion.ts';
import {createXtermEmulators} from '/src/terminal/emulator.ts';
import {prepareFixture} from '/src/perf/fixture.ts';
import {observePreference,glyphDisplacement,preferenceSettlement} from '/src/perf/frame_run.ts';
import {runChecks} from '/src/testing/checks.ts';
try {
const c=seedApp('empty-project',Date.now()),a=c.app;
const reduced=createRoot(()=>createReducedMotion(()=>({matches:false,addEventListener:(_type,listener)=>{window.switchPreference=()=>listener({matches:true});},removeEventListener:()=>{}})));
window.journal=[];
window.reduced=reduced;
window.stop=observePreference(reduced,()=>performance.now(),()=> 'sample',window.journal,()=>window.fixture?{glyphs:glyphDisplacement(window.fixture)}:{},{previousFrame:()=>window.previous,afterUpdate:cb=>setTimeout(cb,0),read:()=>preferenceSettlement('glyphs',window.fixture)});
const emulator=createXtermEmulators();
render(()=>App({app:a,reducedMotion:reduced,clock:Date.now,createEmulator:emulator}),document.querySelector('#root'));
const h=await a.rpc('rail.createWorkstream',{name:'measurement',parent:null});
const t=await a.rpc('terminal.open',{workstream:h.id});
const spawn=a.handlers['agent.spawn'];
a.handlers['agent.spawn']=async p=>{const row=await spawn(p);await a.rpc('rail.rename',{id:row.id,name:p.name});return {...row,name:p.name};};
a.handlers['agent.signal']=p=>{c.setStatus(p.id,p.payload.hook_event_name==='UserPromptSubmit'?'working':'idle','fixture');return null;};
window.fixture=await prepareFixture(a,'/Users/you/harness',t.terminal_id);
for(const control of document.querySelectorAll('.rail [aria-expanded=false] .rail-chevron'))control.click();
window.read=()=>({engine:'chromium',fixture:window.fixture,journal:window.journal,arcs:glyphDisplacement(window.fixture),settlement:preferenceSettlement('glyphs',window.fixture),checks:runChecks(),qualification:'Chromium injected preference seam only; crossing pair and shared-source settlement, no native source, scheduling run, stream accounting or WKWebView timing'});
window.ready=true;
window.crossing=[];
window.startCrossing=()=>{
const deadline=performance.now()+1000;
const sample=()=>{
const current={at_ms:performance.now(),reduced:reduced(),glyphs:glyphDisplacement(window.fixture)};
const prior=window.previous;
const crossed=prior?.glyphs?.some(before=>before.degrees<180&&current.glyphs.some(after=>after.target===before.target&&after.degrees>=180&&after.degrees<360));
if(crossed){window.crossing=[prior,current];window.switchPreference();return;}
window.previous=current;
if(performance.now()<deadline)requestAnimationFrame(sample);else window.crossingFailure='No observed crossing within existing one-second input bound';
};
requestAnimationFrame(sample);
};
}catch(e){window.failure=String(e);}
<\/script></body></html>`;
document.body.append(frame);return true;
})()
