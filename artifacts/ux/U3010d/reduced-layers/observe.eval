const {execFileSync}=require('node:child_process');const fs=require('node:fs');
const b=(...args)=>execFileSync('agent-browser',['--session','motion-40489422952',...args],{encoding:'utf8',timeout:60000});
const e=code=>JSON.parse(b('eval',`document.querySelector('#motion-observer').contentWindow.eval(${JSON.stringify(code)})`));
const dir=process.cwd()+'/artifacts/ux/U3010d/reduced-layers';
const stream='ws://127.0.0.1:39557';
const index=Number(process.argv[2]??0);const name=process.argv[3]??'reserved-drawer';
const result=e(`(async()=>{
const input=new WebSocket(${JSON.stringify(stream)});await new Promise((resolve,reject)=>{input.onopen=resolve;input.onerror=reject;});
const frame=()=>new Promise(r=>requestAnimationFrame(r));
const key=key=>{const escape=key==='Escape',tab=key==='Tab';for(const eventType of ['keyDown','keyUp'])input.send(JSON.stringify({type:'input_keyboard',eventType,key,code:escape?'Escape':tab?'Tab':'Space'}));};
const activate=selector=>{
const target=document.querySelector(selector);if(!target)throw new Error('missing target '+selector);
const edge=selector==='.drawer',box=(edge?target:target.querySelector('svg')??target).getBoundingClientRect();
const x=box.left+(edge?parseFloat(getComputedStyle(target).borderLeftWidth)/2:box.width/2),y=box.top+box.height/2;
for(const eventType of ['mousePressed','mouseReleased']) input.send(JSON.stringify({type:'input_mouse',eventType,x,y,button:'left',clickCount:1}));
};
try {
switchPreference(true);await frame();
document.querySelector('.shelf [data-todo="1"] .todo-row-button')?.click();
const start=journal.length;let done=false;const sequence=cycle(${index}).then(result=>{done=true;return result;});
for(let segment=0;segment<3;segment++){
activate(${index}===0?(segment===1?'.drawer':'.shelf [data-todo="1"] .row-controls button[aria-label="Open"]'):'.shelf-tab[data-selected]');
while(!journal[start+segment]?.completed&&!done)await frame();
if(!journal[start+segment]?.completed)throw new Error('uncompleted segment '+segment);
}
if(${index}===0){const deadline=performance.now()+900;while(!document.querySelector('.drawer').contains(document.activeElement)&&performance.now()<deadline){key('Tab');await frame();}}
key(${index}===0?'Escape':' ');
const completed=await sequence;
return {...read(),completed,mode:document.querySelector('[data-layout-root]').dataset.shelfMode,focus:document.activeElement?.outerHTML};
}catch(error){return {...read(),error:String(error),completed:false,mode:document.querySelector('[data-layout-root]').dataset.shelfMode};}finally{input.close();}
})()`);
fs.writeFileSync(dir+'/'+name+'.json',JSON.stringify(result,null,2));
console.log(JSON.stringify({completed:result.completed,error:result.error,mode:result.mode,actions:result.journal.map(a=>({panel:a.panel,criterion:a.criterion,reduced:a.reduced,completed:a.completed})),checks:Object.entries(result.checks).filter(([,v])=>v.status!=='pass')}));
b('screenshot',dir+'/'+name+'.png');
