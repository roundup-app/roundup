(async()=>{
const frame=document.createElement('iframe');frame.id='motion-observer';frame.style='position:fixed;inset:0;width:1512px;height:950px;border:0;z-index:99999';
frame.srcdoc=`<!doctype html><html><head></head><body style="margin:0"><div id="root"></div><script type="module">
import '/src/tokens.css';import '/src/styles.css';import '/src/scrollbar.css';
import {createRoot} from '/node_modules/.vite/deps/solid-js.js';
import {render} from '/node_modules/.vite/deps/solid-js_web.js';
import {App} from '/src/App.tsx';import {seedApp} from '/src/testing/seeds.ts';
import {createReducedMotion} from '/src/app/reducedMotion.ts';
import {createXtermEmulators} from '/src/terminal/emulator.ts';
import {prepareFixture} from '/src/perf/fixture.ts';
import {domLayers,layersCycle,expandFixtureTodos} from '/src/perf/frame_run.ts';
import {runChecks} from '/src/testing/checks.ts';
try {
const c=seedApp('empty-project',Date.now()),a=c.app;
const reduced=createRoot(()=>createReducedMotion(()=>({matches:false,addEventListener:(_type,listener)=>{window.switchPreference=value=>listener({matches:value});},removeEventListener:()=>{}})));
window.reduced=reduced;window.journal=[];window.controls=domLayers(window.journal,undefined,reduced);
render(()=>App({app:a,reducedMotion:reduced,clock:Date.now,createEmulator:createXtermEmulators()}),document.querySelector('#root'));
const h=await a.rpc('rail.createWorkstream',{name:'measurement',parent:null});const t=await a.rpc('terminal.open',{workstream:h.id});
const spawn=a.handlers['agent.spawn'];a.handlers['agent.spawn']=async p=>{const row=await spawn(p);await a.rpc('rail.rename',{id:row.id,name:p.name});return {...row,name:p.name};};
a.handlers['agent.signal']=p=>{c.setStatus(p.id,p.payload.hook_event_name==='UserPromptSubmit'?'working':'idle','fixture');return null;};
window.fixture=await prepareFixture(a,'/Users/you/harness',t.terminal_id);
for(const control of document.querySelectorAll('.rail [aria-expanded=false] .rail-chevron'))control.click();
window.read=()=>({engine:'chromium',fixture:window.fixture,viewport:{width:innerWidth,height:innerHeight},reduced:reduced(),journal:window.journal,checks:runChecks(),qualification:'Chromium injected shared preference seam and trusted browser actions only; no native source, stream, sample, halfway switch or WKWebView timing'});
window.openShelf=async()=>{document.querySelector('.rail [data-id="'+h.id+'"] .row-state').click();if(document.querySelector('[data-layout-root]').dataset.shelf!=='open'){document.body.dispatchEvent(new KeyboardEvent('keydown',{key:'k',code:'KeyK',metaKey:true,bubbles:true,cancelable:true}));await new Promise(r=>requestAnimationFrame(r));document.body.dispatchEvent(new KeyboardEvent('keydown',{key:'s',code:'KeyS',bubbles:true,cancelable:true}));}await expandFixtureTodos(window.fixture);return true;};
window.cycle=index=>layersCycle(window.controls,reduced)(index);
window.ready=true;
}catch(e){window.failure=String(e);}
<\/script></body></html>`;
document.body.append(frame);return true;
})()
