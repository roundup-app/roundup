 // Version: 0.3.309
 
+// roundup's version-pinned raw storage extension; helpers stay owned by this SDK.
+async function roundupSources(sessionId) {
+  if (!Be(sessionId)) throw new Error('Invalid sessionId (must be a UUID)');
+  // Check access explicitly: the vendor enumeration otherwise turns a failed root read
+  // into an empty result. Never authorize a successful empty lookup on that failure.
+  try { await PJ(ht()); } catch (error) {
+    if (error.code === 'ENOENT') return [];
+    throw error;
+  }
+  const matches = [];
+  for (const directory of await M9e({})) {
+    const path = ds(directory, `${sessionId}.jsonl`);
+    try {
+      const metadata = await I9e(path);
+      if (!metadata.isFile()) throw new Error(`Not a saved conversation file: ${path}`);
+      matches.push(path);
+    } catch (error) {
+      if (error.code !== 'ENOENT' && error.code !== 'ENOTDIR') throw error;
+    }
+  }
+  return matches;
+}
+
+export async function roundupResolveSession(sessionId) {
+  const matches = await roundupSources(sessionId);
+  if (matches.length > 1) throw new Error(`Duplicate source identity: ${sessionId}`);
+  if (!matches.length) throw new Error(`Saved conversation ${sessionId} not found; Refresh to try again`);
+  return matches[0];
+}
+
+export async function roundupCreateDestination(sessionId, directory) {
+  if (!Be(sessionId)) throw new Error('Invalid sessionId (must be a UUID)');
+  if (typeof directory !== 'string' || !l9e(directory)) throw new Error('Destination requires an absolute Project directory');
+  if ((await roundupSources(sessionId)).length) throw new Error(`Saved identity already exists: ${sessionId}`);
+  // Use the same SDK path builder as local transcript writes, including long hashes.
+  const projectDir = fl(Cv(directory));
+  await hD(projectDir, { recursive: true });
+  const path = ds(projectDir, `${sessionId}.jsonl`);
+  const handle = await P9e(path, 'wx', 0o600);
+  try { return path; } finally { await handle.close(); }
+}
