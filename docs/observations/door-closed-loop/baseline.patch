+//! First failing adapter assertions from DCL3; no vendor credentials or wall-clock wait.
+use agents::{AgentAdapter, Observation, claude_code::ClaudeCode};
+use contracts::Kind;
+use serde_json::json;
+
+#[test]
+fn dcl3_background_bash_monitor_and_task_hold_working() {
+    let mut shell = std::process::Command::new("sleep")
+        .arg("30")
+        .spawn()
+        .unwrap();
+    let mut adapter = ClaudeCode::new(|| 0);
+    adapter.observe(Observation::Signal(
+        json!({"hook_event_name":"UserPromptSubmit","prompt":"background work"}),
+    ));
+    adapter.observe(Observation::Signal(json!({"hook_event_name":"PreToolUse","tool_name":"Bash","tool_input":{"command":"sleep 30","run_in_background":true}})));
+    adapter.observe(Observation::Signal(json!({"hook_event_name":"PostToolUse","tool_name":"Bash","tool_response":{"task_id":"dcl-shell","status":"running","output_file":"/tmp/dcl-shell.output"}})));
+    adapter.observe(Observation::Signal(json!({"hook_event_name":"Stop"})));
+    let live = shell.try_wait().unwrap().is_none();
+    shell.kill().unwrap();
+    shell.wait().unwrap();
+    assert!(live, "probe requires a live background shell at Stop");
+    assert_eq!(
+        adapter.status().unwrap().kind,
+        Kind::Working,
+        "DCL3 foreground Stop must not finish live background Bash"
+    );
+}
