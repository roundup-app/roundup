+                    dir.path().join("claude.json"),
+                    rup,
+                    None,
+                ),
+                agents::worktree::Git::from_env(),
+            )
+            .unwrap()
+            .with_clock(move || reading.load(Ordering::SeqCst))
+        })
+        .unwrap();
+        let door = call(
+            &daemon,
+            "rail.createWorkstream",
+            json!({"name":"inactive Door","parent":null}),
+        )
+        .await;
+        let node = call(&daemon, "rail.startDoor", json!({"id":door["id"]})).await;
+        for payload in [
+            json!({"hook_event_name":"SessionStart","session_id":"00000000-0000-4000-8000-000000000099"}),
+            json!({"hook_event_name":"UserPromptSubmit","prompt":"bounded job"}),
+        ] {
+            call(
+                &daemon,
+                "agent.signal",
+                json!({"id":door["id"],"attempt":node["attempt"],"payload":payload}),
+            )
+            .await;
+        }
+        let before = call(&daemon, "rail.tree", Value::Null).await;
+        assert_eq!(
+            before[0]["status"]["kind"], "working",
+            "probe needs a live working Door"
+        );
+        tokio::time::pause();
+        clock.store(600_001, Ordering::SeqCst);
+        tokio::time::advance(std::time::Duration::from_secs(31)).await;
+        let tree = call(&daemon, "rail.tree", Value::Null).await;
+        tokio::time::resume();
+        call(&daemon, "agent.stop", json!({"id":door["id"]})).await;
+        assert!(
+            tree.to_string().contains("stall"),
+            "DCL5 inactive Door must expose its own stall: {tree}"
+        );
+    }
+}
