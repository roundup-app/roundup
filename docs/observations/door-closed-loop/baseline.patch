+//! Initial failing DCL assertions; replay only, not the complete implementation suite.
+use super::*;
+
+async fn workstream(run: &Run) -> String {
+    run.user
+        .request(
+            "rail.createWorkstream",
+            json!({"name":"DCL work","parent":null}),
+        )
+        .await
+        .unwrap()["id"]
+        .as_str()
+        .unwrap()
+        .to_owned()
+}
+
+async fn ordered_child(run: &mut Run) -> String {
+    let door = workstream(run).await;
+    let caller = Client::connect(&run.daemon.socket).await.unwrap();
+    caller
+        .request(
+            "daemon.identify",
+            json!({"actor":{"kind":"agent","id":door}}),
+        )
+        .await
+        .unwrap();
+    let node = caller
+        .request(
+            "agent.spawn",
+            json!({"name":"bounded job","cwd":run.dir.path(),"role":"job"}),
+        )
+        .await
+        .unwrap();
+    run.child = node["id"].as_str().unwrap().to_owned();
+    run.terminal = node["terminal_id"].clone();
+    run.attempt = node["attempt"].clone();
+    run.ready().await;
+    run.signal(
+        json!({"hook_event_name":"UserPromptSubmit","prompt":"bounded outcome; report then end"}),
+    )
+    .await;
+    door
+}
+
+#[tokio::test]
+async fn dcl1_unreadable_transcript_exposes_delivery_failure() {
+    let run = Run::start().await;
+    // Invalid UTF-8 is a read failure even if malformed JSON lines become tolerant.
+    std::fs::write(run.dir.path().join("transcript.jsonl"), [0xff, b'\n']).unwrap();
+    run.signal(json!({"hook_event_name":"Stop"})).await;
+    let id = run.note("retain unreadable-transcript message").await;
+    assert_eq!(run.status(id).await.0, "pending");
+    let row = run.rail_node().await;
+    assert!(
+        row.to_string().contains("can't reach"),
+        "DCL1 missing actionable delivery failure: {row}"
+    );
+}
+
+#[tokio::test]
+async fn dcl5_kill_reports_owned_open_todos_without_reassigning() {
+    let mut run = Run::open(1, false).await;
+    let door = ordered_child(&mut run).await;
+    let mut owned = Vec::new();
+    for i in 0..7 {
+        owned.push(
+            run.user
+                .request(
+                    "todo.create",
+                    json!({"title":format!("owned {i}"),"owner":{"kind":"agent","id":run.child}}),
+                )
+                .await
+                .unwrap(),
+        );
+    }
+    for i in 0..14 {
+        run.user
+            .request("todo.create", json!({"title":format!("unassigned {i}")}))
+            .await
+            .unwrap();
+    }
+    let session = std::fs::read_dir(run.sessions())
+        .unwrap()
+        .map(Result::unwrap)
+        .find(|f| f.path().extension().is_some_and(|e| e == "json"))
+        .unwrap();
+    let listing: Value = serde_json::from_slice(&std::fs::read(session.path()).unwrap()).unwrap();
+    assert!(
+        std::process::Command::new("kill")
+            .arg("-KILL")
+            .arg(listing["pid"].as_u64().unwrap().to_string())
+            .status()
+            .unwrap()
+            .success()
+    );
+    until("killed child reaped", async || {
+        matches!(run.rail_status().await.as_str(), "done" | "error").then_some(())
+    })
+    .await;
+    // Observe for one supervisor pass plus 1s scheduling tolerance. No additional event repairs it.
+    let found = tokio::time::timeout(Duration::from_secs(31), async {
+        loop {
+            let notes = run
+                .user
+                .request("message.list", json!({"to":door}))
+                .await
+                .unwrap();
+            if notes.as_array().unwrap().iter().any(|m| {
+                let body = m["body"].as_str().unwrap();
+                body.contains("7 open") && body.contains("no report")
+            }) {
+                break;
+            }
+            tokio::time::sleep(Duration::from_millis(20)).await;
+        }
+    })
+    .await;
+    let todos = run.user.request("todo.list", Value::Null).await.unwrap();
+    for todo in owned {
+        assert!(
+            todos
+                .as_array()
+                .unwrap()
+                .iter()
+                .any(|t| t["id"] == todo["id"] && t["owner"] == todo["owner"])
+        );
+    }
+    assert!(
+        found.is_ok(),
+        "DCL5 no ending note naming seven owned open Todos and no report within 31s"
+    );
+}
+
+#[tokio::test]
+async fn dcl9_idle_job_without_report_is_actionable_consult_idle_is_rest() {
+    let mut run = Run::open(1, false).await;
+    let door = ordered_child(&mut run).await;
+    run.signal(json!({"hook_event_name":"Stop"})).await;
+    let found = tokio::time::timeout(Duration::from_secs(31), async {
+        loop {
+            let notes = run
+                .user
+                .request("message.list", json!({"to":door}))
+                .await
+                .unwrap();
+            if notes
+                .as_array()
+                .unwrap()
+                .iter()
+                .any(|m| m["body"].as_str().unwrap().contains("no report"))
+            {
+                break;
+            }
+            tokio::time::sleep(Duration::from_millis(20)).await;
+        }
+    })
+    .await;
+    assert!(
+        found.is_ok(),
+        "DCL9 idle Job without current report produced no actionable stop fact within 31s"
+    );
+}
+
+#[tokio::test]
+async fn dcl8_stopped_and_crashed_door_keep_backlog_across_restart() {
+    let mut run = Run::open(1, false).await;
+    run.child = workstream(&run).await;
+    let node = run
+        .user
+        .request("rail.startDoor", json!({"id":run.child}))
+        .await
+        .unwrap();
+    run.terminal = node["terminal_id"].clone();
+    run.attempt = node["attempt"].clone();
+    run.ready().await;
+    run.signal(json!({"hook_event_name":"UserPromptSubmit","prompt":"busy Door"}))
+        .await;
+    let first = run.note("first original identity").await;
+    let second = run.note("second original identity").await;
+    assert_eq!(run.status(first).await.0, "pending");
+    run.user
+        .request("agent.stop", json!({"id":run.child}))
+        .await
+        .unwrap();
+    // First required boundary; failure here deliberately precedes crash/restart.
+    for id in [first, second] {
+        assert_eq!(
+            run.status(id).await.0,
+            "pending",
+            "DCL8 stopping Door must preserve original {id}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn dcl4_burst_crash_at_each_delivery_boundary_replays_all_facts() {
+    let mut run = Run::open(1, false).await;
+    let door = ordered_child(&mut run).await;
+    let running = run
+        .user
+        .request("rail.startDoor", json!({"id":door}))
+        .await
+        .unwrap();
+    until("Door fake program ready", async || {
+        let screen = run
+            .user
+            .request(
+                "terminal.read",
+                json!({"id":running["terminal_id"],"after":0}),
+            )
+            .await
+            .unwrap();
+        screen["text"]
+            .as_str()
+            .unwrap()
+            .contains("READY")
+            .then_some(())
+    })
+    .await;
+    run.user.request("agent.signal", json!({"id":door,"attempt":running["attempt"],"payload":{"hook_event_name":"UserPromptSubmit","prompt":"busy Door"}})).await.unwrap();
+    // Refuse publication after the authoritative Todo writes. Kill at the first boundary:
+    // stored fact, no durable Message. Later boundaries remain implementation obligations.
+    std::fs::write(run.dir.path().join("fault"), "push").unwrap();
+    let child = Client::connect(&run.daemon.socket).await.unwrap();
+    child
+        .request(
+            "daemon.identify",
+            json!({"actor":{"kind":"agent","id":run.child,"parent":door}}),
+        )
+        .await
+        .unwrap();
+    for i in 0..100 {
+        child
+            .request(
+                "todo.create",
+                json!({"title":format!("burst {i}"),"owner":{"kind":"agent","id":run.child}}),
+            )
+            .await
+            .unwrap();
+    }
+    until(
+        "all stored facts compared before killing Daemon",
+        async || {
+            std::fs::read_to_string(run.dir.path().join("comparisons"))
+                .unwrap_or_default()
+                .lines()
+                .filter_map(|s| serde_json::from_str::<Value>(s).ok())
+                .any(|v| v["todos"].as_array().is_some_and(|t| t.len() == 100))
+                .then_some(())
+        },
+    )
+    .await;
+    assert!(
+        std::fs::read_to_string(run.dir.path().join("rupd.err"))
+            .unwrap()
+            .contains("injected failure in push"),
+        "publication fault must actually fire before the kill"
+    );
+    run.daemon.child.kill().unwrap();
+    run.daemon.child.wait().unwrap();
+    std::fs::remove_file(&run.daemon.socket).unwrap();
+    std::fs::remove_file(run.dir.path().join("fault")).unwrap();
+    run.daemon = launch(run.dir.path(), run.data.path());
+    run.user = Client::connect(&run.daemon.socket).await.unwrap();
+    let found = tokio::time::timeout(Duration::from_secs(31), async {
+        loop {
+            let messages = run
+                .user
+                .request("message.list", json!({"to":door}))
+                .await
+                .unwrap();
+            if messages
+                .as_array()
+                .unwrap()
+                .iter()
+                .any(|m| m["body"].as_str().unwrap().contains("open todos: 100"))
+            {
+                break;
+            }
+            tokio::time::sleep(Duration::from_millis(20)).await;
+        }
+    })
+    .await;
+    assert!(
+        found.is_ok(),
+        "DCL4 startup plus one supervisor pass lost stored burst before Message publication"
+    );
+}
+
+#[tokio::test]
+async fn dcl1_previous_read_and_write_errors_keep_original_pending_batch_previous_read() {
+    let run = Run::start().await;
+    let path = run.dir.path().join("transcript.jsonl");
+    if path.exists() {
+        std::fs::remove_file(&path).unwrap();
+    }
+    std::fs::create_dir(&path).unwrap();
+    let id = run.note("previous-entry read fault").await;
+    assert_eq!(run.status(id).await.0, "pending");
+    let row = run.rail_node().await;
+    assert!(
+        row.to_string().contains("can't reach"),
+        "DCL1 previous-entry read failure is silent: {row}"
+    );
+}
+
+#[tokio::test]
+async fn dcl1_previous_read_and_write_errors_keep_original_pending_batch_write() {
+    let run = Run::start().await;
+    // Preserve the live, listed session and canonical path, but make the transport refuse connections.
+    let session = std::fs::read_dir(run.sessions())
+        .unwrap()
+        .map(Result::unwrap)
+        .find(|f| f.path().extension().is_some_and(|e| e == "json"))
+        .unwrap();
+    let listing: Value = serde_json::from_slice(&std::fs::read(session.path()).unwrap()).unwrap();
+    std::fs::remove_file(listing["messagingSocketPath"].as_str().unwrap()).unwrap();
+    std::fs::write(
+        listing["messagingSocketPath"].as_str().unwrap(),
+        "refused transport",
+    )
+    .unwrap();
+    let id = run.note("inbox transport write fault").await;
+    assert_eq!(run.status(id).await.0, "pending");
+    let row = run.rail_node().await;
+    assert!(
+        row.to_string().contains("can't reach"),
+        "DCL1 inbox write failure has no actionable cause: {row}"
+    );
+}
