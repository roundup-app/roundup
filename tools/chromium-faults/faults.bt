// Root waits on a pipe until BEGIN confirms every probe has attached. Track TIDs so
// a Chromium fork from any thread belongs to this command, never the host.
BEGIN {
  @integrity = 0;
  @tree[$1] = 1;
  // The sentinel makes an empty snapshot distinguishable from a lost print.
  @live[0] = ((uint64)0, (uint64)0, (uint64)0, (uint64)0, (uint64)0, (uint64)0, (uint64)0, (uint64)0, (uint32)0, "");
  printf("READY\n");
}
tracepoint:sched:sched_process_fork /@tree[args.parent_pid]/ {
  @tree[args.child_pid] = 1;
  if (!@tree[args.child_pid]) { @integrity = 1; }
  if (@chrome[args.parent_pid]) {
    @chrome[args.child_pid] = 1;
    if (!@chrome[args.child_pid]) { @integrity = 1; }
  }
}
tracepoint:sched:sched_process_exec /@tree[tid]/ {
  if (comm == "chrome" || comm == "chromium" || comm == "chromium-browse") {
    @chrome[tid] = 1;
    if (!@chrome[tid]) { @integrity = 1; }
  }
}
kfunc:filemap_fault /@chrome[tid]/ {
  $v = args.vmf->vma;
  // The explicit BTF cast resolves file's forward declaration on bpftrace 0.20.
  $file = (struct file *)$v->vm_file;
  @fault[tid] = (pid, args.vmf->address, args.vmf->pgoff * $2,
                nsecs, $v->vm_start, $v->vm_end, $v->vm_pgoff * $2,
                $file->f_inode->i_ino, $file->f_inode->i_sb->s_dev);
  // Bound the tuple below bpftrace's 256-byte allocation limit on releases
  // whose default str() capacity is 1024; 64 preserves the older capacity.
  @name[tid] = str($file->f_path.dentry->d_name.name, 64);
  if (!@fault[tid].3 || @name[tid] == "") { @integrity = 1; }
}
// This is the stack at the actual wait, rather than filemap_fault's caller.
// Kernel-owned identity survives a stalled or lossy userspace consumer.
tracepoint:sched:sched_switch /@fault[tid].3 && (args.prev_state & 3) && !@blocked[tid]/ {
  @blocked[tid] = 1;
  $f = @fault[tid];
  @live[tid] = ($f.0, $f.1, $f.2, $f.3, $f.4, $f.5, $f.6, $f.7, $f.8, @name[tid]);
  @stack[tid, $f.3] = kstack(24);
  if (!@blocked[tid] || @live[tid].3 != $f.3) { @integrity = 1; }
}
kretfunc:filemap_fault /@fault[tid].3/ {
  $f = @fault[tid];
  if (@blocked[tid] || @samples < 64) {
    if (!@blocked[tid]) { @samples = @samples + 1; }
    printf("COMPLETED %lu %d %lu %lu %lu %lu %lu %lu %lu %lu %lu %u\n%s\n", $f.0, tid, $f.1, $f.2, $f.3, $f.4, $f.5, $f.6, $f.7, $f.8, nsecs - $f.3, retval, @name[tid]);
  }
  if (@live[tid].3) { delete(@stack[tid, @live[tid].3]); delete(@live[tid]); }
  delete(@fault[tid]); delete(@name[tid]);
  if (@blocked[tid]) { delete(@blocked[tid]); }
}
tracepoint:sched:sched_process_exit /@tree[tid]/ {
  if (@live[tid].3) { delete(@stack[tid, @live[tid].3]); delete(@live[tid]); }
  delete(@tree[tid]);
  if (@chrome[tid]) { delete(@chrome[tid]); }
  if (@fault[tid].3) { delete(@fault[tid]); delete(@name[tid]); }
  if (@blocked[tid]) { delete(@blocked[tid]); }
}
// print(map) reads the kernel map in userspace, not an event-stream replica.
// Require both the envelope and sentinel map, even for an empty live set.
interval:ms:100 {
  printf("SNAPSHOT\n"); print(@live); print(@stack); print(@integrity); printf("SNAPSHOT_END\n");
}
END {
  // bpftrace detaches the other probes before END: this last map is stable.
  printf("FINAL\n"); print(@live); print(@stack); print(@integrity); printf("FINAL_END\n");
  clear(@live); clear(@stack);
  clear(@tree); clear(@chrome); clear(@fault); clear(@blocked); clear(@name);
  clear(@samples); clear(@integrity);
}
