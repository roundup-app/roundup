(async () => {
  const rows = () => [...document.querySelectorAll('.shelf [data-shelf-group="unassigned"] .todo-list .todo-row-button')];
  const frame = () => new Promise(requestAnimationFrame);
  if (!rows().length) {
    const tab = document.querySelector('#shelf-tab-todos');
    if (tab.getAttribute('aria-expanded') !== 'true') tab.click();
    document.querySelector('[data-todo-root]').click();
    await frame();
    document.querySelector('[data-todo-root]').click();
    document.querySelector('.shelf [data-shelf-group="unassigned"] [data-part="branch-control"]')?.click();
  }
  const group = document.querySelector('.shelf [data-shelf-group="unassigned"]');
  if (group?.getAttribute('aria-expanded') !== 'true') group?.querySelector('[data-part="branch-control"]')?.click();
  for (let i = 0; i < 120 && (rows().length < 2 || !rows()[1].getBoundingClientRect().height); i++) await frame();
  if (rows().length < 2) throw new Error('missing reorder target');
  const out = window.__nestOut === true;
  const callsBefore = window.__fake.app.calls.filter(call => call.method === 'todo.reorder').length;
  const effects = [];
  const original = Element.prototype.animate;
  Element.prototype.animate = function(...args) {
    if (this.matches('.todo-row')) effects.push({ frames: args[0], options: args[1] });
    return original.apply(this, args);
  };
  const read = () => ({ t: performance.now(), rows: rows().map(row => ({ label: row.getAttribute('aria-label'), level: row.closest('.todo-row').getAttribute('aria-level'), top: row.closest('.todo-row').getBoundingClientRect().top, transform: getComputedStyle(row.closest('.todo-row')).transform })), running: rows().flatMap(row => row.closest('.todo-row').getAnimations().map(animation => ({label: row.getAttribute('aria-label'), state: animation.playState, time: animation.currentTime}))), focus: document.activeElement?.getAttribute('aria-label') });
  const samples = [read()];
  const id = row => Number(/#(\d+)/.exec(row.getAttribute('aria-label'))[1]);
  await window.__fake.app.rpc('todo.reorder', { id: id(rows()[4]), before: id(rows()[6]) });
  for (let i = 0; i < 120 && !rows().some(row => row.closest('.todo-row').getAnimations().some(animation => animation.currentTime > 0)); i++) await frame();
  const effectsBeforeKey = effects.length;
  const target = id(rows()[out ? 3 : 1]);
  samples.push(read());
  const button = rows()[out ? 3 : 1];
  button.focus();
  if (window.__nestRefuse) window.__fake.failNext(-32003, 'Nesting refused. Choose another Todo.');
  button.dispatchEvent(new KeyboardEvent('keydown', { key: 'Tab', shiftKey: out, bubbles: true, cancelable: true }));
  samples.push(read());
  for (let i = 0; i < 35; i++) { await frame(); samples.push(read()); }
  Element.prototype.animate = original;
  return { direction: out ? 'out' : 'in', target, effectsBeforeKey, viewport: [innerWidth, innerHeight], dark: matchMedia('(prefers-color-scheme: dark)').matches, effects, samples, calls: window.__fake.app.calls.filter(call => ['todo.reorder', 'todo.setBlockers'].includes(call.method)).slice(callsBefore), checks: await window.__checks() };
})()
