{
  "name": "roundup",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "lint": "node tools/oxlint/anti-slop/web-assertions/lint.mjs",
    "typecheck": "tsc",
    "slop": "fallow dead-code && fallow dupes",
    "postinstall": "node node_modules/@anthropic-ai/claude-code/install.cjs",
    "prepare": "lefthook install --force",
    "test:token-integration": "node --test docs/u478-check-integration.test.mjs",
    "lint:styles": "stylelint \"apps/desktop/src/**/*.css\" --max-warnings 0",
    "tokens:check": "if [ -f docs/ui-tokens.test.mjs ]; then node --test docs/ui-tokens.test.mjs; fi",
    "lint:boundaries": "ast-grep --version",
    "lint:cycles": "node tools/lint/cycles.mjs ."
  },
  "devDependencies": {
    "@actions/expressions": "^0.3.61",
    "@anthropic-ai/claude-code": "2.1.300",
    "@ast-grep/cli": "0.51.0",
    "@copilotkit/aimock": "1.45.1",
    "@oxlint/plugins": "1.86.0",
    "fallow": "^3.34.0",
    "lefthook": "2.2.2",
    "mdn-data": "2.27.1",
    "oxlint": "1.86.0",
    "stylelint": "17.16.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "@zag-js/toast@1.45.0": "patches/@zag-js__toast@1.45.0.patch",
      "@dnd-kit/dom@0.5.1": "patches/@dnd-kit__dom@0.5.1.patch",
      "@zag-js/splitter@1.45.0": "patches/@zag-js__splitter@1.45.0.patch",
      "@ark-ui/solid@5.39.3": "patches/@ark-ui__solid@5.39.3.patch",
      "@copilotkit/aimock@1.45.1": "patches/@copilotkit__aimock@1.45.1.patch",
      "@xterm/addon-fit@0.11.0": "patches/@xterm__addon-fit@0.11.0.patch",
      "overlayscrollbars@2.17.0": "patches/overlayscrollbars@2.17.0.patch",
      "@zag-js/radio-group@1.45.0": "patches/@zag-js__radio-group@1.45.0.patch",
      "@zag-js/focus-trap@1.45.0": "patches/@zag-js__focus-trap@1.45.0.patch",
      "@zag-js/dialog@1.45.0": "patches/@zag-js__dialog@1.45.0.patch",
      "@pierre/diffs@1.6.1": "patches/@pierre__diffs@1.6.1.patch",
      "@xterm/xterm@6.0.0": "patches/@xterm__xterm@6.0.0.patch",
      "@anthropic-ai/claude-agent-sdk@0.3.309": "patches/@anthropic-ai__claude-agent-sdk@0.3.309.patch",
      "@zag-js/live-region@1.45.0": "patches/@zag-js__live-region@1.45.0.patch",
      "@pierre/trees@1.0.0-beta.6": "patches/@pierre__trees@1.0.0-beta.6.patch"
    },
    "packageExtensions": {
      "@pierre/trees@1.0.0-beta.6": {
        "dependencies": {
          "@zag-js/collection": "1.45.0"
        }
      }
    }
  }
}
